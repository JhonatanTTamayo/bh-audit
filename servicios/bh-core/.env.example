# Puerto en el que se ejecutará el microservicio bh-core
PORT=3000

# URL de conexión a la base de datos
DATABASE_URL="mysql://usuario:password@localhost:3306/bh_core"

# Clave secreta usada para firmar tokens JWT
JWT_SECRET=

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN=1d

# Servidor SMTP para envío de correos
MAIL_HOST=smtp.gmail.com

# Puerto del servidor SMTP
MAIL_PORT=587

# Usuario del correo emisor
MAIL_USER=correo@ejemplo.com

# Contraseña o app password del correo emisor
MAIL_PASS=password_app_o_clave_smtp

# Dirección que aparecerá como remitente
MAIL_FROM=correo@ejemplo.com
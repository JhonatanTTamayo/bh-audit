generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
   url= env("DATABASE_URL")
}

/// Representa a los usuarios registrados dentro del sistema.
///
/// Este modelo almacena la información principal del usuario,
/// incluyendo sus datos personales, credenciales cifradas,
/// estado de cuenta y relación con su rol.

model Usuario {
  id               String        @id @default(uuid())
  nombreCompleto   String        @map("nombre_completo")
  correo           String        @unique
  telefono         String?
  contrasenaHash   String        @map("contrasena_hash")
  estado           EstadoUsuario @default(PENDIENTE_VERIFICACION)
  correoVerificado Boolean       @default(false) @map("correo_verificado")

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  codigosVerificacion CodigoVerificacion[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

/// Representa los roles disponibles dentro del sistema.
///
/// Un rol permite clasificar a los usuarios y será utilizado
/// posteriormente para aplicar reglas de autorización.

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("roles")
}

/// Representa los códigos usados para verificar el correo
/// electrónico de un usuario.
///
/// Este modelo permitirá controlar si un código ya fue usado,
/// cuándo expira y a qué usuario pertenece.

model CodigoVerificacion {
  id       String    @id @default(uuid())
  codigo   String
  usado    Boolean   @default(false)
  usadoEn  DateTime? @map("usado_en")
  expiraEn DateTime  @map("expira_en")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("codigos_verificacion")
}

/// Definimos el cliente
model Cliente {
  id String @id @default(uuid())

  nombre    String
  apellido  String
  documento String @unique
  direccion String
  telefono  String
  email     String @unique

  mascotas Mascota[]

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("clientes")
}

model Mascota {
  id String @id @default(uuid())

  nombre          String
  especie         String
  raza            String?
  color           String
  fechaNacimiento DateTime @map("fecha_nacimiento")
  peso    Decimal?      @db.Decimal(10, 2)

  estado EstadoMascota @default(ACTIVA)

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([clienteId])
  @@map("mascotas")
}

/// Define los posibles estados de una cuenta de usuario.

enum EstadoUsuario {
  PENDIENTE_VERIFICACION
  PENDIENTE_APROBACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}
/**
 * =========================
 * HISTORIAL MÉDICO
 * =========================
 */

model HistorialMedico {
  id String @id @default(uuid())

  motivoConsulta String @map("motivo_consulta")

  diagnostico String

  tratamiento String

  pesoMascota Decimal @map("peso_mascota") @db.Decimal(10, 2)

  fechaProximaVisita DateTime? @map("fecha_proxima_visita")

  estado EstadoHistorial @default(CERRADO)

  mascotaId String @map("mascota_id")
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String @map("veterinario_id")
  veterinario   Usuario @relation("VeterinarioHistoriales", fields: [veterinarioId], references: [id])

  medicamentos MedicamentoPrescrito[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("historiales_medicos")
}

model MedicamentoPrescrito {
  id String @id @default(uuid())

  historialId String            @map("historial_id")
  historial   HistorialMedico   @relation(fields: [historialId], references: [id])

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("medicamentos_prescritos")
}

/**
 * =========================
 * PRODUCTOS
 * =========================
 */

model Producto {
  id String @id @default(uuid())

  nombre String
  tipo   TipoProducto

  stock       Int
  stockMinimo Int @map("stock_minimo")

  precio Decimal @db.Decimal(10, 2)

  fechaVencimiento DateTime @map("fecha_vencimiento")

  activo Boolean @default(true)

  medicamentosPrescritos MedicamentoPrescrito[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("productos")
}


enum EstadoHistorial {
  ABIERTO
  CERRADO
}

enum TipoProducto {
  MEDICAMENTO
  VACUNA
  INSUMO_QUIRURGICO
}
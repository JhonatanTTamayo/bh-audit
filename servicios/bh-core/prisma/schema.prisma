generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id               String        @id @default(uuid())
  nombreCompleto   String        @map("nombre_completo")
  correo           String        @unique
  contrasenaHash   String        @map("contrasena_hash")
  estado           EstadoUsuario @default(PENDIENTE_VERIFICACION)
  correoVerificado Boolean       @default(false) @map("correo_verificado")

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  codigosVerificacion CodigoVerificacion[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("roles")
}

model CodigoVerificacion {
  id       String    @id @default(uuid())
  codigo   String
  usado    Boolean   @default(false)
  usadoEn  DateTime? @map("usado_en")
  expiraEn DateTime  @map("expira_en")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("codigos_verificacion")
}

enum EstadoUsuario {
  PENDIENTE_VERIFICACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}

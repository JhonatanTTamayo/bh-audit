generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String        @id @default(uuid())
  nombreCompleto   String        @map("nombre_completo")
  correo           String        @unique
  telefono         String?
  contrasenaHash   String        @map("contrasena_hash")
  estado           EstadoUsuario @default(PENDIENTE_VERIFICACION)
  correoVerificado Boolean       @default(false) @map("correo_verificado")

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  codigosVerificacion CodigoVerificacion[]
  citasVeterinario    Cita[]               @relation("VeterinarioCitas")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("roles")
}

model CodigoVerificacion {
  id       String    @id @default(uuid())
  codigo   String
  usado    Boolean   @default(false)
  usadoEn  DateTime? @map("usado_en")
  expiraEn DateTime  @map("expira_en")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("codigos_verificacion")
}

model Cliente {
  id        String @id @default(uuid())
  nombre    String
  apellido  String
  documento String @unique
  direccion String
  telefono  String
  email     String @unique

  mascotas Mascota[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("clientes")
}

model Mascota {
  id      String        @id @default(uuid())
  nombre  String
  especie String
  raza    String?
  edad    Int?
  peso    Decimal?      @db.Decimal(10, 2)
  estado  EstadoMascota @default(ACTIVA)

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  citas Cita[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([clienteId])
  @@map("mascotas")
}

model Servicio {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)

  citas CitaServicio[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("servicios")
}

model Cita {
  id                String     @id @default(uuid())
  fecha             DateTime   @db.Date
  hora              String     @db.VarChar(5)
  estado            EstadoCita @default(CONFIRMADA)
  montoTotal        Decimal    @map("monto_total") @db.Decimal(10, 2)
  motivoCancelacion String?    @map("motivo_cancelacion") @db.VarChar(500)

  mascotaId String  @map("mascota_id")
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String  @map("veterinario_id")
  veterinario   Usuario @relation("VeterinarioCitas", fields: [veterinarioId], references: [id])

  servicios CitaServicio[]
  pago      Pago?

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([mascotaId])
  @@index([veterinarioId, fecha, hora])
  @@map("citas")
}

model CitaServicio {
  citaId String @map("cita_id")
  cita   Cita   @relation(fields: [citaId], references: [id])

  servicioId String   @map("servicio_id")
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  precioAplicado Decimal @map("precio_aplicado") @db.Decimal(10, 2)

  @@id([citaId, servicioId])
  @@index([servicioId])
  @@map("citas_servicios")
}

model Pago {
  id         String     @id @default(uuid())
  metodo     MetodoPago
  referencia String?
  monto      Decimal    @db.Decimal(10, 2)
  fechaPago  DateTime   @default(now()) @map("fecha_pago")

  citaId String @unique @map("cita_id")
  cita   Cita   @relation(fields: [citaId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("pagos")
}

model Inventario {
  id               Int       @id @default(autoincrement())
  nombre           String
  tipo             String
  stock            Int
  stockMinimo      Int       @map("stock_minimo")
  precio           Decimal   @db.Decimal(10, 2)
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  activo           Boolean   @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("inventario")
}

enum EstadoUsuario {
  PENDIENTE_VERIFICACION
  PENDIENTE_APROBACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}

enum EstadoMascota {
  ACTIVA
  HOSPITALIZADA
  FALLECIDA
}

enum EstadoCita {
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * USUARIOS Y ROLES
 * =========================
 */

model Usuario {
  id               String        @id @default(uuid())
  nombreCompleto   String        @map("nombre_completo")
  correo           String        @unique
  telefono         String?
  contrasenaHash   String        @map("contrasena_hash")
  estado           EstadoUsuario @default(PENDIENTE_VERIFICACION)
  correoVerificado Boolean       @default(false) @map("correo_verificado")
  motivoRechazo    String?       @map("motivo_rechazo")

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  codigosVerificacion   CodigoVerificacion[]
  mascotas              Mascota[]          @relation("ClienteMascotas")
  citasVeterinario      Cita[]             @relation("VeterinarioCitas")
  historialesVeterinario HistorialMedico[] @relation("VeterinarioHistoriales")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("roles")
}

model CodigoVerificacion {
  id       String    @id @default(uuid())
  codigo   String
  usado    Boolean   @default(false)
  usadoEn  DateTime? @map("usado_en")
  expiraEn DateTime  @map("expira_en")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("codigos_verificacion")
}

/**
 * =========================
 * FACTURACIÓN
 * =========================
 */

model Atencion {
  id     String   @id @default(uuid())
  fecha  DateTime @default(now())

  servicios    ServicioAtencion[]
  medicamentos MedicamentoAtencion[]

  factura Factura?

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("atenciones")
}

model ServicioAtencion {
  id String @id @default(uuid())

  nombre String

  precio Decimal @db.Decimal(10, 2)

  atencionId String    @map("atencion_id")
  atencion   Atencion  @relation(fields: [atencionId], references: [id])

  @@map("servicios_atencion")
}

model MedicamentoAtencion {
  id String @id @default(uuid())

  nombre String

  precio Decimal @db.Decimal(10, 2)

  cantidad Int

  atencionId String    @map("atencion_id")
  atencion   Atencion  @relation(fields: [atencionId], references: [id])

  @@map("medicamentos_atencion")
}

model Factura {
  id String @id @default(uuid())

  atencionId String    @unique @map("atencion_id")
  atencion   Atencion  @relation(fields: [atencionId], references: [id])

  totalFacturado Decimal @map("total_facturado") @db.Decimal(10, 2)

  descuento Decimal @default(0) @db.Decimal(10, 2)

  estado EstadoFactura @default(EMITIDA)

  motivoAnulacion String? @map("motivo_anulacion")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("facturas")
}

/**
 * =========================
 * CLÍNICA
 * =========================
 */

model Mascota {
  id      String        @id @default(uuid())
  nombre  String
  especie String
  raza    String?
  edad    Int?
  peso    Decimal?      @db.Decimal(10, 2)
  estado  EstadoMascota @default(ACTIVA)

  clienteId String  @map("cliente_id")
  cliente   Usuario @relation("ClienteMascotas", fields: [clienteId], references: [id])

  citas       Cita[]
  historiales HistorialMedico[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([clienteId])
  @@map("mascotas")
}

model Servicio {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)

  citas CitaServicio[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("servicios")
}

model Cita {
  id                String      @id @default(uuid())
  fecha             DateTime
  hora              String
  estado            EstadoCita  @default(CONFIRMADA)
  montoTotal        Decimal     @map("monto_total") @db.Decimal(10, 2)
  motivoCancelacion String?     @map("motivo_cancelacion")

  mascotaId String
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String
  veterinario   Usuario @relation("VeterinarioCitas", fields: [veterinarioId], references: [id])

  servicios CitaServicio[]
  pago      Pago?

  creadoEn DateTime @default(now())

  @@map("citas")
}

model CitaServicio {
  citaId String
  cita   Cita @relation(fields: [citaId], references: [id])

  servicioId String
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  precioAplicado Decimal @db.Decimal(10, 2)

  @@id([citaId, servicioId])
  @@map("citas_servicios")
}

model Pago {
  id         String      @id @default(uuid())
  metodo     MetodoPago
  referencia String?
  monto      Decimal     @db.Decimal(10, 2)
  fechaPago  DateTime    @default(now())

  citaId String @unique
  cita   Cita   @relation(fields: [citaId], references: [id])

  creadoEn DateTime @default(now())

  @@map("pagos")
}

/**
 * =========================
 * HISTORIAL MÉDICO
 * =========================
 */

model HistorialMedico {
  id String @id @default(uuid())

  motivoConsulta String @map("motivo_consulta")

  diagnostico String

  tratamiento String

  pesoMascota Decimal @map("peso_mascota") @db.Decimal(10, 2)

  fechaProximaVisita DateTime? @map("fecha_proxima_visita")

  estado EstadoHistorial @default(CERRADO)

  mascotaId String @map("mascota_id")
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String @map("veterinario_id")
  veterinario   Usuario @relation("VeterinarioHistoriales", fields: [veterinarioId], references: [id])

  medicamentos MedicamentoPrescrito[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("historiales_medicos")
}

model MedicamentoPrescrito {
  id String @id @default(uuid())

  historialId String            @map("historial_id")
  historial   HistorialMedico   @relation(fields: [historialId], references: [id])

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("medicamentos_prescritos")
}

/**
 * =========================
 * PRODUCTOS
 * =========================
 */

model Producto {
  id String @id @default(uuid())

  nombre String
  tipo   TipoProducto

  stock       Int
  stockMinimo Int @map("stock_minimo")

  precio Decimal @db.Decimal(10, 2)

  fechaVencimiento DateTime @map("fecha_vencimiento")

  activo Boolean @default(true)

  medicamentosPrescritos MedicamentoPrescrito[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("productos")
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum EstadoUsuario {
  PENDIENTE_VERIFICACION
  PENDIENTE_APROBACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}

enum EstadoMascota {
  ACTIVA
  HOSPITALIZADA
  FALLECIDA
}

enum EstadoCita {
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum EstadoFactura {
  EMITIDA
  ANULADA
}

enum EstadoHistorial {
  ABIERTO
  CERRADO
}

enum TipoProducto {
  MEDICAMENTO
  VACUNA
  INSUMO_QUIRURGICO
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String        @id @default(uuid())
  nombreCompleto   String        @map("nombre_completo")
  correo           String        @unique
  telefono         String?
  contrasenaHash   String        @map("contrasena_hash")
  estado           EstadoUsuario @default(PENDIENTE_VERIFICACION)
  correoVerificado Boolean       @default(false) @map("correo_verificado")

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  codigosVerificacion CodigoVerificacion[]

  citasVeterinario Cita[]   @relation("CitasVeterinario")
  cliente          Cliente?

  historiales HistorialMedico[] @relation("VeterinarioHistoriales")

  vacunasAplicadas Vacuna[] @relation("VeterinarioVacunas")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("roles")
}

model CodigoVerificacion {
  id       String    @id @default(uuid())
  codigo   String
  usado    Boolean   @default(false)
  usadoEn  DateTime? @map("usado_en")
  expiraEn DateTime  @map("expira_en")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("codigos_verificacion")
}

model Cliente {
  id String @id @default(uuid())

  nombre    String
  apellido  String
  documento String @unique
  direccion String
  telefono  String
  email     String @unique

  usuarioId String?  @unique @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  mascotas Mascota[]

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("clientes")
}

model Mascota {
  id String @id @default(uuid())

  nombre          String
  especie         String
  raza            String?
  color           String
  fechaNacimiento DateTime @map("fecha_nacimiento")
  peso            Decimal? @db.Decimal(10, 2)

  estado EstadoMascota @default(ACTIVA)

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  citas     Cita[]

  historiales HistorialMedico[]
  vacunas Vacuna[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([clienteId])
  @@map("mascotas")
}

model HistorialMedico {
  id String @id @default(uuid())

  motivoConsulta     String          @map("motivo_consulta")
  diagnostico        String
  tratamiento        String
  pesoMascota        Decimal         @map("peso_mascota") @db.Decimal(10, 2)
  fechaProximaVisita DateTime?       @map("fecha_proxima_visita")
  estado             EstadoHistorial @default(CERRADO)

  mascotaId String  @map("mascota_id")
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String  @map("veterinario_id")
  veterinario   Usuario @relation("VeterinarioHistoriales", fields: [veterinarioId], references: [id])

  medicamentos MedicamentoPrescrito[]
  vacunas Vacuna[] @relation("HistorialVacunas")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("historiales_medicos")
}

/**
 * =========================
 * PRODUCTOS
 * =========================
 */

model MedicamentoPrescrito {
  id String @id @default(uuid())

  historialId String          @map("historial_id")
  historial   HistorialMedico @relation(fields: [historialId], references: [id])

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("medicamentos_prescritos")
}

model Producto {
  id String @id @default(uuid())

  nombre String
  tipo   TipoProducto

  stock       Int
  stockMinimo Int @map("stock_minimo")

  precio           Decimal  @db.Decimal(10, 2)
  fechaVencimiento DateTime @map("fecha_vencimiento")
  activo           Boolean  @default(true)

  medicamentosPrescritos MedicamentoPrescrito[]
  atenciones             Atencion[]
  vacunas Vacuna[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("productos")
}

/**
 * =========================
 * FACTURACION / ATENCIONES
 * =========================
 */

model Atencion {
  id String @id @default(uuid())

  servicios    Servicio[]
  medicamentos Producto[]
  factura      Factura?

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("atenciones")
}

model Factura {
  id String @id @default(uuid())

  atencionId String   @unique @map("atencion_id")
  atencion   Atencion @relation(fields: [atencionId], references: [id])

  metodoPago      String?       @map("metodo_pago")
  totalFacturado  Decimal       @map("total_facturado") @db.Decimal(10, 2)
  descuento       Decimal       @default(0) @db.Decimal(10, 2)
  estado          EstadoFactura @default(EMITIDA)
  motivoAnulacion String?       @map("motivo_anulacion")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("facturas")
}

/**
 * =========================
 * VACUNAS
 * =========================
 */

model Vacuna {
  id String @id @default(uuid())

  nombre String

  fechaAplicacion   DateTime @map("fecha_aplicacion") @db.Date
  fechaProximaDosis DateTime @map("fecha_proxima_dosis") @db.Date

  observaciones String?

  mascotaId String @map("mascota_id")
  mascota Mascota @relation(fields: [mascotaId],references: [id])

  historialId String? @map("historial_id")
  historial HistorialMedico? @relation("HistorialVacunas",fields: [historialId],references: [id])

  productoId String? @map("producto_id")
  producto Producto? @relation(fields: [productoId],references: [id])

  veterinarioId String @map("veterinario_id")
  veterinario Usuario @relation("VeterinarioVacunas",fields: [veterinarioId],references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@index([mascotaId])
  @@index([fechaProximaDosis])

  @@map("vacunas")
}

/**
 * =========================
 * CITAS
 * =========================
 */

model Servicio {
  id String @id @default(uuid())

  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)

  citas      CitaServicio[]
  atenciones Atencion[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("servicios")
}

model Cita {
  id String @id @default(uuid())

  fecha             DateTime   @db.Date
  hora              String     @db.VarChar(5)
  estado            EstadoCita @default(CONFIRMADA)
  montoTotal        Decimal    @map("monto_total") @db.Decimal(10, 2)
  motivoCancelacion String?    @map("motivo_cancelacion") @db.VarChar(500)

  mascotaId String  @map("mascota_id")
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String  @map("veterinario_id")
  veterinario   Usuario @relation("CitasVeterinario", fields: [veterinarioId], references: [id])

  servicios CitaServicio[]
  pago      Pago?

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([mascotaId])
  @@index([veterinarioId, fecha, hora])
  @@map("citas")
}

model CitaServicio {
  citaId         String  @map("cita_id")
  servicioId     String  @map("servicio_id")
  precioAplicado Decimal @map("precio_aplicado") @db.Decimal(10, 2)

  cita     Cita     @relation(fields: [citaId], references: [id])
  servicio Servicio @relation(fields: [servicioId], references: [id])

  @@id([citaId, servicioId])
  @@index([servicioId])
  @@map("citas_servicios")
}

model Pago {
  id String @id @default(uuid())

  metodo     MetodoPago
  referencia String?
  monto      Decimal    @db.Decimal(10, 2)
  fechaPago  DateTime   @default(now()) @map("fecha_pago")

  citaId String @unique @map("cita_id")
  cita   Cita   @relation(fields: [citaId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("pagos")
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum EstadoUsuario {
  PENDIENTE_VERIFICACION
  PENDIENTE_APROBACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}

enum EstadoMascota {
  ACTIVA
  HOSPITALIZADA
  FALLECIDA
}

enum EstadoHistorial {
  ABIERTO
  CERRADO
}

enum EstadoFactura {
  EMITIDA
  ANULADA
}

enum TipoProducto {
  MEDICAMENTO
  VACUNA
  INSUMO_QUIRURGICO
}

enum EstadoCita {
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}
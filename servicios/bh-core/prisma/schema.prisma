generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Representa a los usuarios registrados dentro del sistema.
///
/// Este modelo almacena la información principal del usuario,
/// incluyendo sus datos personales, credenciales cifradas,
/// estado de cuenta y relación con su rol.

model Usuario {
  id               String        @id @default(uuid())
  nombreCompleto   String        @map("nombre_completo")
  correo           String        @unique
  telefono         String?
  contrasenaHash   String        @map("contrasena_hash")
  estado           EstadoUsuario @default(PENDIENTE_VERIFICACION)
  correoVerificado Boolean       @default(false) @map("correo_verificado")
  motivoRechazo    String?       @map("motivo_rechazo")

  rolId String @map("rol_id")
  rol   Rol    @relation(fields: [rolId], references: [id])

  codigosVerificacion CodigoVerificacion[]
  mascotas            Mascota[]            @relation("ClienteMascotas")
  citasVeterinario    Cita[]               @relation("VeterinarioCitas")

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("usuarios")
}

/// Representa los roles disponibles dentro del sistema.
///
/// Un rol permite clasificar a los usuarios y será utilizado
/// posteriormente para aplicar reglas de autorización.

model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?
  activo      Boolean @default(true)

  usuarios Usuario[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("roles")
}

/// Representa los códigos usados para verificar el correo
/// electrónico de un usuario.
///
/// Este modelo permitirá controlar si un código ya fue usado,
/// cuándo expira y a qué usuario pertenece.

model CodigoVerificacion {
  id       String    @id @default(uuid())
  codigo   String
  usado    Boolean   @default(false)
  usadoEn  DateTime? @map("usado_en")
  expiraEn DateTime  @map("expira_en")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("codigos_verificacion")
}

/// Representa una mascota registrada para un cliente del sistema.
///
/// Cada mascota pertenece a un usuario con rol cliente y puede tener
/// multiples citas asociadas.

model Mascota {
  id      String        @id @default(uuid())
  nombre  String
  especie String
  raza    String?
  edad    Int?
  peso    Decimal?      @db.Decimal(10, 2)
  estado  EstadoMascota @default(ACTIVA)

  clienteId String  @map("cliente_id")
  cliente   Usuario @relation("ClienteMascotas", fields: [clienteId], references: [id])

  citas Cita[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([clienteId])
  @@map("mascotas")
}

/// Representa un servicio ofrecido por la clinica veterinaria.
///
/// Los servicios activos pueden ser seleccionados al agendar una cita
/// y su precio se usa para calcular el monto total.

model Servicio {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(10, 2)
  activo      Boolean @default(true)

  citas CitaServicio[]

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@map("servicios")
}

/// Representa una cita agendada para una mascota con un veterinario.
///
/// La cita se crea confirmada solo cuando existe pago asociado.

model Cita {
  id                String     @id @default(uuid())
  fecha             DateTime   @db.Date
  hora              String     @db.VarChar(5)
  estado            EstadoCita @default(CONFIRMADA)
  montoTotal        Decimal    @map("monto_total") @db.Decimal(10, 2)
  motivoCancelacion String?    @map("motivo_cancelacion") @db.VarChar(500)

  mascotaId String  @map("mascota_id")
  mascota   Mascota @relation(fields: [mascotaId], references: [id])

  veterinarioId String  @map("veterinario_id")
  veterinario   Usuario @relation("VeterinarioCitas", fields: [veterinarioId], references: [id])

  servicios CitaServicio[]
  pago      Pago?

  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  @@index([mascotaId])
  @@index([veterinarioId, fecha, hora])
  @@map("citas")
}

/// Relaciona las citas con los servicios seleccionados.
///
/// Guarda el precio aplicado para conservar el valor historico aunque
/// el precio del servicio cambie posteriormente.

model CitaServicio {
  citaId String @map("cita_id")
  cita   Cita   @relation(fields: [citaId], references: [id])

  servicioId String   @map("servicio_id")
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  precioAplicado Decimal @map("precio_aplicado") @db.Decimal(10, 2)

  @@id([citaId, servicioId])
  @@index([servicioId])
  @@map("citas_servicios")
}

/// Representa el pago obligatorio asociado a una cita confirmada.

model Pago {
  id         String     @id @default(uuid())
  metodo     MetodoPago
  referencia String?
  monto      Decimal    @db.Decimal(10, 2)
  fechaPago  DateTime   @default(now()) @map("fecha_pago")

  citaId String @unique @map("cita_id")
  cita   Cita   @relation(fields: [citaId], references: [id])

  creadoEn DateTime @default(now()) @map("creado_en")

  @@map("pagos")
}

/// Define los posibles estados de una cuenta de usuario.

enum EstadoUsuario {
  PENDIENTE_VERIFICACION
  PENDIENTE_APROBACION
  ACTIVO
  SUSPENDIDO
  RECHAZADO
}

/// Define los posibles estados de una mascota.

enum EstadoMascota {
  ACTIVA
  HOSPITALIZADA
  FALLECIDA
}

/// Define los posibles estados de una cita.

enum EstadoCita {
  CONFIRMADA
  FINALIZADA
  CANCELADA
}

/// Define los metodos de pago permitidos al agendar una cita.

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}
